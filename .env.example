# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Supabase transaction pooler (Dashboard > Connect > Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Free-tier spike only
SPIKE_TOKEN=<long random string>
SPIKE_BASE_URL=https://<deployment>.vercel.app
